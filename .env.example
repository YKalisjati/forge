# Forge Platform Configuration Template
# Synthetic values for local development and testing only

# --- Application Environment ---
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- API Service ---
API_PORT=8080
API_SHUTDOWN_TIMEOUT=10s
API_READ_TIMEOUT=5s
API_WRITE_TIMEOUT=10s
API_MAX_PAYLOAD_BYTES=1048576

# --- PostgreSQL (Source of Truth) ---
DB_HOST=localhost
# Use 5432 (default in docker) or 5433 if running on host with pre-existing PostgreSQL
DB_PORT=5432
DB_USER=forge_user
DB_PASSWORD=forge_secret_dev
DB_NAME=forge_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# --- RabbitMQ (Message Transport) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=forge.jobs.direct
RABBITMQ_QUEUE=forge.jobs
RABBITMQ_DLQ=forge.jobs.dlq

# --- Redis (Optional Rate Limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# --- Outbox Relay Configuration ---
RELAY_POLL_INTERVAL=100ms
RELAY_BATCH_SIZE=100
RELAY_MAX_RETRIES=5

# --- Worker Configuration ---
WORKER_CONCURRENCY=10
WORKER_PREFETCH_COUNT=20
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_SHUTDOWN_TIMEOUT=30s

# --- Stale Job Reaper ---
REAPER_INTERVAL=30s
REAPER_BATCH_SIZE=50
